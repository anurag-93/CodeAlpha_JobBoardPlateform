PORT=5001
NODE_ENV=development
# Standard MongoDB connection string (e.g., local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/jobboard
# Set to true to automatically use in-memory MongoDB if local MongoDB is not running
USE_IN_MEMORY_DB=auto
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads/resumes
MAX_FILE_SIZE_MB=5
